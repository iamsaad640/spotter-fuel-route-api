# Copy to .env for Docker Compose, or export in your shell. Django never reads .env itself.

# Django
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# HTTPS deployments behind a TLS-terminating proxy
DJANGO_BEHIND_TLS_PROXY=false
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_NUM_PROXIES=0

# Routing provider (any OSRM-compatible HTTPS endpoint)
ROUTING_BASE_URL=https://router.project-osrm.org
ROUTING_TIMEOUT_SECONDS=12
ROUTE_CACHE_SECONDS=86400
REDIS_URL=

# Planning
ROUTE_CORRIDOR_MILES=12
ORIGIN_RADIUS_MILES=25
FUEL_STOP_PENALTY_USD=10
FUEL_ROUTE_RATE_LIMIT=60/min

LOG_LEVEL=INFO
